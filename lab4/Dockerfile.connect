FROM maven:3.9.9-eclipse-temurin-11 AS hierarchy-handler-builder
WORKDIR /build
COPY lab5/mongo-handler/pom.xml ./
COPY lab5/mongo-handler/src ./src
RUN mvn --batch-mode --no-transfer-progress package

FROM confluentinc/cp-kafka-connect:7.6.1

# Debezium 1.9 поддерживает установленный в PostgreSQL wal2json.
ARG DEBEZIUM_VERSION=1.9.7.Final
ARG NEO4J_CONNECTOR_VERSION=5.1.9
ARG MONGODB_CONNECTOR_VERSION=1.11.2
RUN mkdir -p /usr/share/confluent-hub-components/debezium-postgres \
 && curl -fsSL "https://repo.maven.apache.org/maven2/io/debezium/debezium-connector-postgres/${DEBEZIUM_VERSION}/debezium-connector-postgres-${DEBEZIUM_VERSION}-plugin.tar.gz" \
    | tar -xz -C /usr/share/confluent-hub-components/debezium-postgres \
 && confluent-hub install --no-prompt confluentinc/kafka-connect-elasticsearch:latest \
 && confluent-hub install --no-prompt "neo4j/kafka-connect-neo4j:${NEO4J_CONNECTOR_VERSION}" \
 && confluent-hub install --no-prompt "mongodb/kafka-connect-mongodb:${MONGODB_CONNECTOR_VERSION}"

# setup-redis.sh скачивает JAR Redis до пересборки этого образа.
COPY lab4/plugins/redis/ /usr/share/confluent-hub-components/redis/

# Пользовательский CdcHandler находится в той же plugin directory, что MongoDB connector.
COPY --from=hierarchy-handler-builder /build/target/university-hierarchy-cdc-handler.jar \
  /usr/share/confluent-hub-components/mongodb-kafka-connect-mongodb/
